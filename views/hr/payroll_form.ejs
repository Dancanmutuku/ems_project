<%- include('../partials/header', { title: 'Generate Payroll' }) %>

<div class="row justify-content-center">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="card overflow-hidden">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold" style="color: var(--text-main);">Generate Employee Payroll</h5>
        <a href="/hr/payrolls" class="btn btn-outline-secondary btn-sm py-1 px-3">
          Back
        </a>
      </div>

      <div class="card-body p-4">
        <form method="POST" action="/hr/payrolls/add">

          <div class="row g-3 mb-4">
            <div class="col-md-12">
              <label class="form-label">Select Employee *</label>
              <select name="employeeId" id="employeeSelect" class="form-select" required onchange="updateSalary()">
                <option value="" disabled selected>-- Select an Employee --</option>
                <% employees.forEach(function(e) { %>
                  <option value="<%= e.id %>" data-salary="<%= e.salary %>">
                    <%= e.fullName %> (<%= e.employeeId %>) — Base Salary: KSh <%= Number(e.salary).toLocaleString() %>
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label">Period Start Date *</label>
              <input type="date" name="periodStart" class="form-control" value="<%= defaultStart %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Period End Date *</label>
              <input type="date" name="periodEnd" class="form-control" value="<%= defaultEnd %>" required>
            </div>

            <div class="col-md-6">
              <label class="form-label">Basic Salary (KSh) *</label>
              <input type="number" step="0.01" id="basicSalary" name="basicSalary" class="form-control" value="0" required oninput="calculateBreakdown()">
            </div>

            <div class="col-md-6">
              <label class="form-label">Allowances (KSh)</label>
              <input type="number" step="0.01" id="allowances" name="allowances" class="form-control" value="0" oninput="calculateBreakdown()">
            </div>
          </div>

          <!-- Dynamic Tax & Deduction Preview Card -->
          <div class="card mb-4" style="background-color: var(--bg-subtle); border: 1px solid var(--border-color);">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="small fw-bold text-uppercase tracking-wider" style="color: var(--text-main);">Kenya Statutory Deductions Preview</span>
                <span class="badge-soft-secondary">Auto-calculated</span>
              </div>
              <div class="row g-3">
                <div class="col-6 col-md-3">
                  <div class="small text-muted mb-1">Gross Pay</div>
                  <strong class="fs-6" style="color: var(--text-main);" id="prevGross">KSh 0.00</strong>
                </div>
                <div class="col-6 col-md-3">
                  <div class="small text-muted mb-1">NSSF Tier 1 & 2</div>
                  <strong class="text-secondary fs-6" id="prevNssf">KSh 0.00</strong>
                </div>
                <div class="col-6 col-md-3">
                  <div class="small text-muted mb-1">SHA (Health)</div>
                  <strong class="text-secondary fs-6" id="prevSha">KSh 0.00</strong>
                </div>
                <div class="col-6 col-md-3">
                  <div class="small text-muted mb-1">PAYE Tax</div>
                  <strong class="text-secondary fs-6" id="prevPaye">KSh 0.00</strong>
                </div>
                <div class="col-12 pt-3 border-top" style="border-color: var(--border-color) !important;">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <span class="fw-semibold" style="color: var(--text-main);">Estimated Net Take-Home:</span>
                      <small class="text-muted d-block">After all mandatory deductions</small>
                    </div>
                    <div class="fs-4 fw-bold" style="color: var(--text-main);" id="prevNet">KSh 0.00</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-2">
            <a href="/hr/payrolls" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
              Save & Process Payroll
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function updateSalary() {
    const sel = document.getElementById('employeeSelect');
    const opt = sel.options[sel.selectedIndex];
    if (opt && opt.dataset.salary) {
      document.getElementById('basicSalary').value = opt.dataset.salary;
      calculateBreakdown();
    }
  }

  function calculateBreakdown() {
    const basic = parseFloat(document.getElementById('basicSalary').value) || 0;
    const allow = parseFloat(document.getElementById('allowances').value) || 0;
    const gross = basic + allow;

    // NSSF
    const tier1 = Math.min(gross, 7000) * 0.06;
    const tier2 = gross > 7000 ? Math.min(gross - 7000, 29000) * 0.06 : 0;
    const nssf = tier1 + tier2;

    // SHA
    const brackets = [
      [5999, 150], [7999, 300], [11999, 400], [14999, 500],
      [19999, 600], [24999, 750], [29999, 850], [34999, 900],
      [39999, 950], [44999, 1000], [49999, 1100], [59999, 1200],
      [69999, 1300], [79999, 1400], [89999, 1500], [99999, 1600]
    ];
    let sha = 1700;
    for (const [limit, amt] of brackets) {
      if (gross <= limit) { sha = amt; break; }
    }

    // PAYE
    const taxable = Math.max(0, gross - nssf);
    let rem = taxable;
    let paye = 0;
    const bands = [[24000, 0.10], [8333, 0.25], [Infinity, 0.30]];
    for (const [bLimit, rate] of bands) {
      if (rem <= 0) break;
      const t = Math.min(rem, bLimit);
      paye += t * rate;
      rem -= t;
    }

    const net = gross - nssf - sha - paye;

    document.getElementById('prevGross').textContent = 'KSh ' + gross.toLocaleString(undefined, {minimumFractionDigits: 2});
    document.getElementById('prevNssf').textContent = 'KSh ' + nssf.toFixed(2);
    document.getElementById('prevSha').textContent = 'KSh ' + sha.toFixed(2);
    document.getElementById('prevPaye').textContent = 'KSh ' + paye.toFixed(2);
    document.getElementById('prevNet').textContent = 'KSh ' + net.toLocaleString(undefined, {minimumFractionDigits: 2});
  }

  document.addEventListener('DOMContentLoaded', calculateBreakdown);
</script>

<%- include('../partials/footer') %>

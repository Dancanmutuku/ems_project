<%- include('../partials/header', { title: 'Leave Management' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h2 class="page-title mb-1">Employee Leave Requests</h2>
    <p class="page-subtitle mb-0">Review pending applications, approval history, and leave allocations</p>
  </div>
</div>

<div class="card overflow-hidden">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-2">
      <h6 class="mb-0 fw-bold" style="color: var(--text-main);">Leave Applications</h6>
      <span class="badge-soft-secondary"><%= leaves.length %> total</span>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Employee</th>
            <th>Type</th>
            <th>Duration</th>
            <th>Dates</th>
            <th>Reason</th>
            <th>Status</th>
            <th class="text-center" style="width: 170px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (leaves.length > 0) { %>
            <% leaves.forEach(function(leave) { %>
              <tr>
                <td>
                  <div class="fw-semibold" style="color: var(--text-main);"><%= leave.employeeName %></div>
                  <small class="text-muted">Balance: <%= leave.leaveBalance %> days</small>
                </td>
                <td><span class="badge-soft-secondary"><%= leave.leaveType %></span></td>
                <td><strong><%= leave.days %></strong> day(s)</td>
                <td class="small text-muted"><%= leave.startDate %> &rarr; <%= leave.endDate %></td>
                <td class="small text-muted"><%= leave.reason || '—' %></td>
                <td>
                  <% if (leave.status === 'P') { %>
                    <span class="badge-soft-warning">Pending</span>
                  <% } else if (leave.status === 'A') { %>
                    <span class="badge-soft-success">Approved</span>
                  <% } else { %>
                    <span class="badge-soft-danger">Rejected</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (leave.status === 'P') { %>
                    <form action="/leaves/process/<%= leave.id %>/approve" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-primary py-1 px-2 me-1">
                        Approve
                      </button>
                    </form>
                    <form action="/leaves/process/<%= leave.id %>/reject" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2">
                        Reject
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-muted small">Decided</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                No leave applications recorded.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Global Theme Switcher Script -->
<script>
  function setAppTheme(newTheme) {
    const htmlEl = document.documentElement;
    htmlEl.setAttribute('data-bs-theme', newTheme);
    localStorage.setItem('ems_theme', newTheme);
    updateThemeButtons(newTheme);
    window.dispatchEvent(new CustomEvent('emsThemeChanged', { detail: { theme: newTheme } }));
  }

  function toggleAppTheme() {
    const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
    setAppTheme(currentTheme === 'dark' ? 'light' : 'dark');
  }

  function updateThemeButtons(theme) {
    const btnLight = document.getElementById('themeBtnLight');
    const btnDark = document.getElementById('themeBtnDark');
    if (btnLight) btnLight.setAttribute('aria-pressed', theme === 'light');
    if (btnDark) btnDark.setAttribute('aria-pressed', theme === 'dark');
  }

  // Initialize button state
  (function() {
    const theme = document.documentElement.getAttribute('data-bs-theme') || 'light';
    updateThemeButtons(theme);
  })();
</script>


<%- include('partials/header', { title: isHr ? 'HR Login' : 'Login' }) %>

<div class="row justify-content-center py-5">
  <div class="col-12 col-md-7 col-lg-5 col-xl-4">
    <div class="card p-2 p-md-3">
      <div class="card-body p-3 p-md-4">
        <div class="text-center mb-4">
          <h4 class="fw-bold mb-1" style="color: var(--text-main);"><%= isHr ? 'HR Administration' : 'Employee Sign In' %></h4>
          <p class="text-muted small mb-0">Sign in to access your workplace records</p>
        </div>

        <form method="POST" action="<%= isHr ? '/hr/login' : '/login' %>">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" class="form-control" id="username" name="username" value="<%= isHr ? 'admin' : 'dancan' %>" required placeholder="Enter username">
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password" value="password123" required placeholder="Enter password">
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3">
            Sign In
          </button>
        </form>

        <!-- Quick Demo Switcher -->
        <div class="pt-3 border-top text-center" style="border-color: var(--border-color) !important;">
          <p class="text-muted small fw-medium mb-2">Instant Demo Access:</p>
          <div class="d-flex gap-2 justify-content-center">
            <a href="/quick-switch?role=HR" class="btn btn-outline-secondary btn-sm flex-fill">
              HR Admin
            </a>
            <a href="/quick-switch?role=Employee" class="btn btn-outline-secondary btn-sm flex-fill">
              Employee
            </a>
          </div>
          <div class="mt-3">
            <% if (isHr) { %>
              <a href="/login" class="small text-decoration-none text-muted">Looking for Employee Login? <span class="text-primary fw-semibold">Click here</span></a>
            <% } else { %>
              <a href="/hr/login" class="small text-decoration-none text-muted">Are you HR Manager? <span class="text-primary fw-semibold">Login here</span></a>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

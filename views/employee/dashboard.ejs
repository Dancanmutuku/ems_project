<%- include('../partials/header', { title: 'Employee Dashboard' }) %>

<div class="mb-4">
  <!-- Profile & Welcome Card -->
  <div class="card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
      <!-- Profile Info -->
      <div class="d-flex align-items-center gap-3">
        <div class="d-flex align-items-center justify-content-center fw-bold rounded-3" style="width: 52px; height: 52px; font-size: 1.15rem; background-color: var(--badge-primary-bg); color: var(--badge-primary-text); border: 1px solid var(--border-color);">
          <%= employee.fullName.split(' ').map(n => n[0]).join('') %>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2">
            <h4 class="page-title mb-0"><%= employee.fullName %></h4>
            <span class="badge-soft-secondary"><%= department ? department.name : 'Techpak' %></span>
          </div>
          <div class="text-muted small mt-1">
            <span><%= employee.jobTitle %></span> &bull; 
            <span>ID: <strong><%= employee.employeeId %></strong></span> &bull; 
            <span>Contract: <%= employee.hireDate %> to <%= employee.contractEnd || 'Permanent' %></span>
          </div>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="d-flex flex-wrap gap-2">
        <div class="px-3 py-2 rounded-2" style="background-color: var(--bg-subtle); border: 1px solid var(--border-color);">
          <div class="text-muted" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Salary</div>
          <div class="fw-bold mt-0.5" style="font-size: 0.95rem; color: var(--text-main);">KSh <%= Number(employee.salary).toLocaleString() %></div>
        </div>
        <div class="px-3 py-2 rounded-2" style="background-color: var(--bg-subtle); border: 1px solid var(--border-color);">
          <div class="text-muted" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Attendance</div>
          <div class="fw-bold mt-0.5" style="font-size: 0.95rem; color: var(--text-main);"><%= totalPresent %> Days</div>
        </div>
        <div class="px-3 py-2 rounded-2" style="background-color: var(--bg-subtle); border: 1px solid var(--border-color);">
          <div class="text-muted" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Leave Balance</div>
          <div class="fw-bold mt-0.5" style="font-size: 0.95rem; color: var(--text-main);"><%= employee.annualLeaveBalance %> Days</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Action Navigation -->
  <div class="d-flex flex-wrap gap-2 mb-4">
    <a href="/attendance/mark" class="btn btn-outline-secondary btn-sm">
      Mark Attendance
    </a>
    <a href="/leaves/add" class="btn btn-outline-secondary btn-sm">
      Request Leave
    </a>
    <a href="/employee/payroll" class="btn btn-outline-secondary btn-sm">
      View Payslips
    </a>
    <a href="/profile" class="btn btn-outline-secondary btn-sm">
      My Profile
    </a>
  </div>

  <!-- Dashboard Cards Row -->
  <div class="row g-4">

    <!-- Recent Payrolls -->
    <div class="col-12 col-lg-6">
      <div class="card h-100 overflow-hidden">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold" style="color: var(--text-main);">Recent Payslips</h6>
          <a href="/employee/payroll" class="btn btn-outline-secondary btn-sm py-1 px-2">View All</a>
        </div>
        <div class="card-body p-0">
          <% if (payrolls.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead>
                  <tr>
                    <th>Period</th>
                    <th>Gross</th>
                    <th>Net Pay</th>
                    <th>Status</th>
                    <th class="text-end">Slip</th>
                  </tr>
                </thead>
                <tbody>
                  <% payrolls.slice(0, 4).forEach(function(p) { %>
                    <tr>
                      <td class="small text-muted"><%= p.periodStart %> &rarr; <%= p.periodEnd %></td>
                      <td>KSh <%= Number(p.grossSalary).toLocaleString() %></td>
                      <td class="fw-bold" style="color: var(--text-main);">KSh <%= Number(p.netPay).toLocaleString() %></td>
                      <td>
                        <span class="<%= p.status === 'Paid' ? 'badge-soft-success' : 'badge-soft-warning' %>">
                          <%= p.status %>
                        </span>
                      </td>
                      <td class="text-end">
                        <a href="/employee/payroll/<%= p.id %>/pdf" target="_blank" class="btn btn-sm btn-outline-secondary py-1 px-2" title="View Payslip">
                          Slip
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="p-4 text-center text-muted">No payroll records yet.</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Attendance Records -->
    <div class="col-12 col-lg-6">
      <div class="card h-100 overflow-hidden">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold" style="color: var(--text-main);">Recent Attendance</h6>
          <a href="/attendance/mark" class="btn btn-outline-secondary btn-sm py-1 px-2">Log Today</a>
        </div>
        <div class="card-body p-0">
          <% if (attendanceRecords.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% attendanceRecords.slice(0, 4).forEach(function(a) { %>
                    <tr>
                      <td class="fw-medium" style="color: var(--text-main);"><%= a.date %></td>
                      <td class="small text-muted"><%= a.checkIn || '—' %></td>
                      <td class="small text-muted"><%= a.checkOut || '—' %></td>
                      <td>
                        <span class="<%= a.status === 'Present' ? 'badge-soft-success' : (a.status === 'Absent' ? 'badge-soft-danger' : 'badge-soft-warning') %>">
                          <%= a.status %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="p-4 text-center text-muted">No attendance recorded recently.</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Leave Requests Summary -->
    <div class="col-12 col-lg-6">
      <div class="card h-100 overflow-hidden">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold" style="color: var(--text-main);">Leave Applications</h6>
          <a href="/leaves/add" class="btn btn-outline-secondary btn-sm py-1 px-2">Apply</a>
        </div>
        <div class="card-body p-0">
          <% if (leaves.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead>
                  <tr>
                    <th>Type</th>
                    <th>Dates</th>
                    <th>Reason</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% leaves.slice(0, 4).forEach(function(l) { %>
                    <tr>
                      <td><span class="badge-soft-secondary"><%= l.leaveType %></span></td>
                      <td class="small text-muted"><%= l.startDate %> &rarr; <%= l.endDate %></td>
                      <td class="small text-muted text-truncate" style="max-width: 150px;"><%= l.reason %></td>
                      <td>
                        <span class="<%= l.status === 'A' ? 'badge-soft-success' : (l.status === 'P' ? 'badge-soft-warning' : 'badge-soft-danger') %>">
                          <%= l.status === 'A' ? 'Approved' : (l.status === 'P' ? 'Pending' : 'Rejected') %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="p-4 text-center text-muted">No leave requests found.</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Notifications -->
    <div class="col-12 col-lg-6">
      <div class="card h-100 overflow-hidden">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold" style="color: var(--text-main);">Announcements & Notices</h6>
          <span class="badge-soft-secondary"><%= notifications.length %></span>
        </div>
        <div class="card-body p-3">
          <% if (notifications.length > 0) { %>
            <div class="list-group list-group-flush">
              <% notifications.forEach(function(n) { %>
                <div class="list-group-item px-0 py-2 border-bottom" style="background: transparent;">
                  <div class="d-flex justify-content-between align-items-start">
                    <h6 class="fw-semibold mb-1" style="font-size: 0.9rem; color: var(--text-main);"><%= n.title %></h6>
                    <small class="text-muted"><%= n.createdAt %></small>
                  </div>
                  <p class="mb-0 text-muted small"><%= n.message %></p>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-muted text-center py-4 mb-0">No new notifications.</p>
          <% } %>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header', { title: 'My Profile' }) %>

<div class="row justify-content-center">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="card overflow-hidden">

      <div class="card-body p-4 border-bottom" style="background-color: var(--card-bg);">
        <div class="d-flex align-items-center gap-3">
          <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 64px; height: 64px; font-size: 1.35rem; background-color: var(--badge-primary-bg); color: var(--badge-primary-text); border: 1px solid var(--border-color);">
            <%= employee.fullName.split(' ').map(n => n[0]).join('') %>
          </div>
          <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-main);"><%= employee.fullName %></h3>
            <p class="text-muted mb-0 small">
              <span class="badge-soft-primary me-2"><%= employee.jobTitle %></span>
              <span class="text-muted"><%= department ? department.name : 'Techpak' %></span>
            </p>
          </div>
        </div>
      </div>

      <div class="card-body p-4">
        <h6 class="fw-bold text-uppercase tracking-wider small mb-3" style="color: var(--text-main);">
          Personal & Employment Record
        </h6>
        <div class="table-responsive mb-4">
          <table class="table table-hover align-middle mb-0">
            <tbody>
              <tr>
                <th class="text-muted w-35 py-2" style="font-weight: 500;">Employee ID:</th>
                <td class="fw-semibold" style="color: var(--text-main);"><%= employee.employeeId %></td>
              </tr>
              <tr>
                <th class="text-muted py-2" style="font-weight: 500;">Work Email:</th>
                <td style="color: var(--text-main);"><%= employee.email %></td>
              </tr>
              <tr>
                <th class="text-muted py-2" style="font-weight: 500;">Contact Phone:</th>
                <td style="color: var(--text-main);"><%= employee.contact %></td>
              </tr>
              <tr>
                <th class="text-muted py-2" style="font-weight: 500;">Date of Birth:</th>
                <td style="color: var(--text-main);"><%= employee.dob %></td>
              </tr>
              <tr>
                <th class="text-muted py-2" style="font-weight: 500;">Gender:</th>
                <td style="color: var(--text-main);"><%= employee.gender === 'M' ? 'Male' : (employee.gender === 'F' ? 'Female' : 'Other') %></td>
              </tr>
              <tr>
                <th class="text-muted py-2" style="font-weight: 500;">Physical Address:</th>
                <td style="color: var(--text-main);"><%= employee.address %></td>
              </tr>
              <tr>
                <th class="text-muted py-2" style="font-weight: 500;">Monthly Basic Salary:</th>
                <td class="fw-bold" style="color: var(--text-main);">KSh <%= Number(employee.salary).toLocaleString() %></td>
              </tr>
              <tr>
                <th class="text-muted py-2" style="font-weight: 500;">Hire Date:</th>
                <td style="color: var(--text-main);"><%= employee.hireDate %></td>
              </tr>
              <tr>
                <th class="text-muted py-2" style="font-weight: 500;">Contract Duration:</th>
                <td style="color: var(--text-main);"><%= employee.contractStart %> &rarr; <%= employee.contractEnd || 'Permanent' %></td>
              </tr>
              <tr>
                <th class="text-muted py-2" style="font-weight: 500;">Annual Leave Balance:</th>
                <td><span class="badge-soft-primary"><%= employee.annualLeaveBalance %> Days Remaining</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <h6 class="fw-bold text-uppercase tracking-wider small mb-3" style="color: var(--text-main);">
          Emergency Contact
        </h6>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <tbody>
              <tr>
                <th class="text-muted w-35 py-2" style="font-weight: 500;">Contact Person:</th>
                <td class="fw-semibold" style="color: var(--text-main);"><%= employee.emergencyContactName || 'Not recorded' %></td>
              </tr>
              <tr>
                <th class="text-muted py-2" style="font-weight: 500;">Phone Number:</th>
                <td style="color: var(--text-main);"><%= employee.emergencyContactPhone || 'Not recorded' %></td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header', { title: 'Leave Applications' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h2 class="page-title mb-1">Leave Applications</h2>
    <p class="page-subtitle mb-0">Apply for time off and track your approval status</p>
  </div>
</div>

<div class="row g-4">
  <!-- Leave Application Form -->
  <div class="col-12 col-lg-4">
    <div class="card">
      <div class="card-header">
        <h6 class="mb-0 fw-bold" style="color: var(--text-main);">Apply for Leave</h6>
      </div>
      <div class="card-body p-4">
        <div class="p-3 mb-3 rounded-3" style="background-color: var(--bg-subtle); border: 1px solid var(--border-color);">
          <small class="text-muted d-block">Current Annual Leave Balance</small>
          <strong class="fs-5" style="color: var(--text-main);"><%= employee.annualLeaveBalance %> days</strong>
        </div>
        <form method="POST" action="/leaves/add">
          <div class="mb-3">
            <label class="form-label">Leave Type *</label>
            <select name="leaveType" class="form-select" required>
              <option value="Annual">Annual Leave</option>
              <option value="Sick">Sick Leave</option>
              <option value="Maternity">Maternity Leave</option>
              <option value="Paternity">Paternity Leave</option>
              <option value="Compassionate">Compassionate Leave</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Start Date *</label>
            <input type="date" name="startDate" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">End Date *</label>
            <input type="date" name="endDate" class="form-control" required>
          </div>
          <div class="mb-4">
            <label class="form-label">Reason / Justification</label>
            <textarea name="reason" class="form-control" rows="3" placeholder="Provide details about your leave request"></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-100 py-2">
            Submit Request
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Leave History Table -->
  <div class="col-12 col-lg-8">
    <div class="card overflow-hidden">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <h6 class="mb-0 fw-bold" style="color: var(--text-main);">Leave History</h6>
          <span class="badge-soft-secondary"><%= leaves.length %> records</span>
        </div>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Type</th>
                <th>Dates</th>
                <th>Days</th>
                <th>Reason</th>
                <th>Submitted</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (leaves.length > 0) { %>
                <% leaves.forEach(function(l) { %>
                  <tr>
                    <td><span class="badge-soft-secondary"><%= l.leaveType %></span></td>
                    <td class="small fw-semibold" style="color: var(--text-main);"><%= l.startDate %> &rarr; <%= l.endDate %></td>
                    <td><strong><%= l.days %></strong></td>
                    <td class="small text-muted"><%= l.reason || '—' %></td>
                    <td class="small text-muted"><%= l.requestedAt %></td>
                    <td>
                      <span class="<%= l.status === 'A' ? 'badge-soft-success' : (l.status === 'P' ? 'badge-soft-warning' : 'badge-soft-danger') %>">
                        <%= l.status === 'A' ? 'Approved' : (l.status === 'P' ? 'Pending' : 'Rejected') %>
                      </span>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center py-5 text-muted">
                    You have not submitted any leave applications yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
